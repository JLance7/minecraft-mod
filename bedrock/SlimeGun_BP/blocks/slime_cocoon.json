{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "slimegun:slime_cocoon",
      "states": {
        "slimegun:permanent": [false, true],
        "slimegun:remaining": {
          "values": {
            "min": 0,
            "max": 15
          }
        }
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "slime_block",
          "render_method": "blend"
        }
      },
      "minecraft:collision_box": false,
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.15
      },
      "minecraft:loot": "loot_tables/empty.json",
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:destructible_by_explosion": false
    },
    "permutations": [
      {
        "condition": "query.block_state('slimegun:permanent') == false",
        "components": {
          "minecraft:tick": { "interval_range": [10, 10], "looping": true },
          "slimegun:decay": {}
        }
      }
    ]
  }
}
